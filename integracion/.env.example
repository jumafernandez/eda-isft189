# Copie este archivo como .env y cambie los valores.
# El archivo .env no se sube al repositorio.

# Clave privada: la usan Flask y Next.js desde el servidor.
# Para generar una: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=cambie-esta-clave-privada

# Clave pública: la usa el widget, que corre en el navegador.
API_KEY_PUBLICA=cambie-esta-clave-publica

# Sitios autorizados a consultar la API desde el navegador, separados por coma.
# En su computadora, el único que lo hace es la página de prueba del widget.
ORIGENES_PERMITIDOS=http://localhost:8080

# Pedidos por minuto que acepta la API de cada dirección IP con la clave pública
LIMITE_POR_MINUTO=30

# Opcional: clave de la API de Anthropic, para el escenario conversacional de la
# aplicación Flask. Si se deja vacía, esa pantalla queda desactivada.
ANTHROPIC_API_KEY=
